{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pilot20.local/schemas/reactive-rules-v2.schema.json",
  "title": "Reactive runtime v2 / Decision v2 (v1 migration in model.js)",
  "description": "Structure plus authoritative runtime cross-reference validation in rules/reactive.js.",
  "$defs": {
    "decision": {
      "type": "object",
      "properties": {
        "version": {
          "const": 2
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
        },
        "eventId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
        },
        "actorId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "status": {
          "enum": [
            "pending",
            "resolved",
            "declined",
            "cancelled"
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
              },
              "label": {
                "type": "string"
              },
              "costs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "resourceId": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
                    },
                    "amount": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1000000
                    }
                  },
                  "required": [
                    "resourceId",
                    "amount"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 30
              }
            },
            "required": [
              "id",
              "label",
              "costs"
            ],
            "additionalProperties": false
          },
          "maxItems": 30
        },
        "continuation": {
          "type": "object",
          "properties": {
            "eventId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
            },
            "phase": {
              "enum": [
                "cast",
                "after-roll",
                "before-hit",
                "after-hit",
                "before-damage",
                "after-damage"
              ]
            }
          },
          "required": [
            "eventId",
            "phase"
          ],
          "additionalProperties": false
        },
        "policy": {
          "const": "block-dependent-resolution"
        },
        "ruleId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
        },
        "phase": {
          "enum": [
            "cast",
            "after-roll",
            "before-hit",
            "after-hit",
            "before-damage",
            "after-damage"
          ]
        },
        "validationRequired": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^external\\."
          }
        }
      },
      "required": [
        "version",
        "id",
        "eventId",
        "actorId",
        "revision",
        "status",
        "options",
        "continuation",
        "policy",
        "ruleId",
        "phase"
      ],
      "additionalProperties": false
    },
    "reactionWindow": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "eventId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
        },
        "phase": {
          "enum": [
            "cast",
            "after-roll",
            "before-hit",
            "after-hit",
            "before-damage",
            "after-damage"
          ]
        },
        "decisionId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
        },
        "status": {
          "const": "pending"
        }
      },
      "required": [
        "version",
        "eventId",
        "phase",
        "decisionId",
        "status"
      ],
      "additionalProperties": false
    },
    "continuation": {
      "type": "object",
      "properties": {
        "command": {
          "type": "object",
          "required": [
            "id",
            "type",
            "actorId",
            "abilityId"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
            },
            "type": {
              "const": "useAbility"
            },
            "actorId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
            },
            "abilityId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
            }
          }
        },
        "ability": {
          "type": "object"
        },
        "targetIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
          },
          "maxItems": 20
        },
        "slotLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "natural": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 20
        },
        "total": {
          "type": [
            "integer",
            "null"
          ]
        },
        "critical": {
          "type": "boolean"
        },
        "hit": {
          "type": "boolean"
        },
        "saves": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
          },
          "additionalProperties": {
            "type": "integer"
          }
        }
      },
      "required": [
        "command",
        "ability",
        "targetIds",
        "slotLevel",
        "natural",
        "total",
        "critical",
        "hit",
        "saves"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "version": {
          "const": 2
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
        },
        "actorId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
        },
        "targetIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
          },
          "maxItems": 20
        },
        "phase": {
          "enum": [
            "cast",
            "after-roll",
            "before-hit",
            "after-hit",
            "before-damage",
            "after-damage"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "status": {
          "enum": [
            "pending",
            "completed",
            "cancelled"
          ]
        },
        "plan": {
          "$ref": "#/$defs/continuation"
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          },
          "maxItems": 200
        },
        "window": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/reactionWindow"
            }
          ]
        },
        "processed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 200
        },
        "modifiers": {
          "type": "object",
          "properties": {
            "attackTotal": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "damageDivisor": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1024
            },
            "cancelled": {
              "type": "boolean"
            },
            "damage": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "dice": {
                    "type": "string"
                  },
                  "damageType": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
                  },
                  "rolls": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000
                    },
                    "maxItems": 100
                  }
                },
                "required": [
                  "dice",
                  "damageType",
                  "rolls"
                ],
                "additionalProperties": false
              },
              "maxItems": 200
            },
            "saves": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              }
            }
          },
          "required": [
            "attackTotal",
            "damageDivisor",
            "cancelled",
            "damage",
            "saves"
          ],
          "additionalProperties": false
        },
        "lockedActorIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
          },
          "maxItems": 100
        },
        "outcome": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "results"
              ],
              "properties": {
                "results": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  },
                  "maxItems": 100
                }
              }
            }
          ]
        },
        "validations": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "boolean",
                "number",
                "string"
              ]
            }
          }
        }
      },
      "required": [
        "version",
        "id",
        "actorId",
        "targetIds",
        "phase",
        "revision",
        "status",
        "plan",
        "decisions",
        "window",
        "processed",
        "modifiers",
        "lockedActorIds",
        "outcome",
        "validations"
      ],
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "version": {
          "const": 2
        },
        "event": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/event"
            }
          ]
        },
        "usage": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
          },
          "maxProperties": 5000,
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          }
        }
      },
      "required": [
        "version",
        "event",
        "usage"
      ],
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
        },
        "trigger": {
          "type": "object",
          "properties": {
            "version": {
              "const": 1
            },
            "event": {
              "enum": [
                "attack-hit",
                "damage-taken",
                "turn-start",
                "turn-end",
                "save-resolved",
                "ally-attacks",
                "zone-enter",
                "spell-cast",
                "attack-roll",
                "ability-targeted",
                "roll-made"
              ]
            },
            "scope": {
              "enum": [
                "self",
                "ally",
                "target",
                "any"
              ]
            },
            "limit": {
              "enum": [
                "none",
                "turn",
                "round",
                "short-rest",
                "long-rest"
              ]
            },
            "whileEffect": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
                }
              ]
            }
          },
          "required": [
            "version",
            "event",
            "scope",
            "limit",
            "whileEffect"
          ],
          "additionalProperties": false
        },
        "phase": {
          "enum": [
            "cast",
            "after-roll",
            "before-hit",
            "after-hit",
            "before-damage",
            "after-damage"
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": -1000,
          "maximum": 1000
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          },
          "maxItems": 20
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
              },
              "label": {
                "type": "string"
              },
              "costs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "resourceId": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
                    },
                    "amount": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1000000
                    }
                  },
                  "required": [
                    "resourceId",
                    "amount"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 30
              },
              "reaction": {
                "type": "boolean"
              },
              "spell": {
                "type": "object",
                "properties": {
                  "level": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9
                  },
                  "slotId": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
                  }
                },
                "required": [
                  "level",
                  "slotId"
                ],
                "additionalProperties": false
              },
              "effects": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "adjust"
                        },
                        "field": {
                          "enum": [
                            "attackTotal",
                            "damageDivisor"
                          ]
                        },
                        "amount": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 100
                        }
                      },
                      "required": [
                        "kind",
                        "field",
                        "amount"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "cancel"
                        }
                      },
                      "required": [
                        "kind"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "effect"
                        },
                        "rule": {
                          "type": "object"
                        }
                      },
                      "required": [
                        "kind",
                        "rule"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "damage"
                        },
                        "dice": {
                          "type": "string",
                          "pattern": "^\\d{1,2}d[468]$"
                        },
                        "damageType": {
                          "type": "string",
                          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
                        }
                      },
                      "required": [
                        "kind",
                        "dice",
                        "damageType"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "counter"
                        },
                        "slotLevel": {
                          "type": "integer",
                          "minimum": 3,
                          "maximum": 9
                        },
                        "bonus": {
                          "type": "integer",
                          "minimum": -20,
                          "maximum": 100
                        }
                      },
                      "required": [
                        "kind",
                        "slotLevel",
                        "bonus"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "rollAdjustment"
                        },
                        "sides": {
                          "enum": [
                            6,
                            8,
                            10,
                            12
                          ]
                        }
                      },
                      "required": [
                        "kind",
                        "sides"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "maxItems": 10
              },
              "tokenId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
              }
            },
            "required": [
              "id",
              "label",
              "costs",
              "reaction",
              "effects"
            ],
            "additionalProperties": false
          },
          "maxItems": 30
        }
      },
      "required": [
        "version",
        "id",
        "trigger",
        "phase",
        "priority",
        "conditions",
        "options"
      ],
      "additionalProperties": false
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "fact": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9.]{0,79}$"
            },
            "equals": {
              "type": [
                "boolean",
                "string",
                "number"
              ]
            }
          },
          "required": [
            "fact",
            "equals"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/condition"
              },
              "minItems": 1,
              "maxItems": 10
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/condition"
              },
              "minItems": 1,
              "maxItems": 10
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "$ref": "#/$defs/runtime"
}
