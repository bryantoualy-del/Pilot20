{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "sourceId",
    "catalog"
  ],
  "properties": {
    "kind": {
      "const": "pilot20-private-rule-pack"
    },
    "schemaVersion": {
      "const": 1
    },
    "sourceId": {
      "enum": [
        "xge",
        "tce"
      ]
    },
    "catalog": {
      "allOf": [
        {
          "$ref": "catalog-v3.schema.json"
        },
        {
          "properties": {
            "items": {
              "minItems": 1
            }
          }
        }
      ]
    }
  }
}
