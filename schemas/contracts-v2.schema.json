            {
              "type": "object",
              "properties": {
                "effectId": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$",
                  "not": {
                    "enum": [
                      "__proto__",
                      "constructor",
                      "prototype"
                    ]
                  }
                },
                "start": {
                  "enum": [
                    "activation",
                    "hit"
                  ]
                }
              },
              "required": [
                "effectId",
                "start"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "save": {
          "anyOf": [
            {
              "type": "object",
