{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pilot20.local/schemas/contracts-v2.schema.json",
  "title": "Pilot20 V0.2 transport contracts",
  "description": "Structural schemas; domain validators also enforce references, bounds, progression and executable coverage.",
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "srd",
            "homebrew",
            "private"
          ]
        },
        "document": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "document",
        "license",
        "url"
      ],
      "additionalProperties": false
    },
    "expression": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string"
            }
          },
          "required": [
            "ref"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "add",
                "multiply",
                "max",
                "min",
                "floor",
                "ceil"
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "minItems": 1,
              "maxItems": 20
            }
          },
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false
        }
      ]
    },
    "dice": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{1,2}d\\d{1,3}([+-]\\d{1,4})?$"
        },
        {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "sides": {
              "type": "integer",
              "minimum": 2,
              "maximum": 100
            },
            "bonus": {
              "$ref": "#/$defs/expression"
            }
          },
          "required": [
            "count",
            "sides",
            "bonus"
          ],
          "additionalProperties": false
        }
      ]
    },
    "effect": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "damage"
              ]
            },
            "amount": {
              "$ref": "#/$defs/expression"
            },
            "dice": {
              "$ref": "#/$defs/dice"
            },
            "damageType": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$",
              "not": {
                "enum": [
                  "__proto__",
                  "constructor",
                  "prototype"
                ]
              }
            },
            "when": {
              "enum": [
                "always",
                "success",
                "failure"
              ]
            }
          },
          "required": [
            "kind",
            "damageType"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "heal",
                "tempHp"
              ]
            },
            "amount": {
              "$ref": "#/$defs/expression"
            },
            "dice": {
              "$ref": "#/$defs/dice"
            },
            "when": {
              "enum": [
                "always",
                "success",
                "failure"
              ]
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "condition",
                "modifier",
                "grantAction",
                "move",
                "summon"
              ]
            },
            "parameters": {
              "type": "object"
            }
          },
          "required": [
            "kind",
            "parameters"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ability": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$",
          "not": {
            "enum": [
              "__proto__",
              "constructor",
              "prototype"
            ]
          }
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "weapon",
            "spell",
            "class",
            "racial",
            "feat",
            "item",
            "custom",
            "passive"
