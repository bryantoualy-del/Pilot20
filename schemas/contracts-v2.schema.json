              "type": "object",
              "properties": {
                "bonus": {
                  "$ref": "#/$defs/expression"
                }
              },
              "required": [
                "bonus"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "resource": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$",
                  "not": {
                    "enum": [
                      "__proto__",
                      "constructor",
                      "prototype"
                    ]
                  }
                },
                "amount": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "id",
                "amount"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
