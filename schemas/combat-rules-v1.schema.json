{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pilot20.invalid/schemas/combat-rules-v1.schema.json",
  "title": "Pilot20 P0 profiles and structural deferred contracts",
  "description": "Structure only. Runtime validators additionally check references, availability, stacking, temporal and resource invariants.",
  "anyOf": [
    {
      "$ref": "#/$defs/profile"
    },
    {
      "$ref": "#/$defs/advancedRuntime"
    },
    {
      "$ref": "#/$defs/coverageRule"
    },
    {
      "$ref": "#/$defs/decision"
    },
    {
      "$ref": "#/$defs/trigger"
    },
    {
      "$ref": "#/$defs/transformation"
    }
  ],
  "$defs": {
    "modifier": {
      "type": "object",
      "properties": {
        "stat": {
          "enum": [
            "ac",
            "speed",
            "attack",
            "damage",
            "save.str",
            "save.dex",
            "save.con",
            "save.int",
            "save.wis",
            "save.cha"
          ]
        },
        "operation": {
          "enum": [
            "add",
            "multiply",
            "set",
            "advantage",
            "disadvantage"
          ]
        },
        "value": {
          "type": "integer",
          "minimum": -1000,
          "maximum": 1000
        }
      },
      "required": [
        "stat",
        "operation",
        "value"
      ],
      "additionalProperties": false
    },
    "effectRule": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$",
          "not": {
            "enum": [
              "__proto__",
              "constructor",
              "prototype"
            ]
          }
        },
        "stack": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$",
              "not": {
                "enum": [
                  "__proto__",
                  "constructor",
                  "prototype"
                ]
              }
            },
            "policy": {
              "enum": [
                "independent",
                "priority",
                "replace"
              ]
            },
            "priority": {
              "type": "integer",
              "minimum": -1000,
              "maximum": 1000
            }
          },
          "required": [
            "key",
            "policy",
            "priority"
          ],
          "additionalProperties": false
        },
        "duration": {
          "type": "object",
          "properties": {
            "unit": {
              "enum": [
                "turn",
                "round",
                "minute"
              ]
            },
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "anchor": {
              "enum": [
                "source",
                "target"
              ]
            },
            "boundary": {
              "enum": [
                "start",
                "end"
              ]
            }
          },
          "required": [
            "unit",
            "value",
            "anchor",
            "boundary"
          ],
          "additionalProperties": false
        },
        "modifiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/modifier"
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "enum": [
              "incapacitated",
              "cannotAct",
              "cannotMove",
              "cannotCast",
              "cannotConcentrate",
              "unconscious"
            ]
          },
          "uniqueItems": true
        },
        "concentration": {
          "type": "boolean"
        },
        "actionGrant": {
          "type": "object",
          "properties": {
            "kinds": {
              "type": "array",
              "items": {
                "enum": [
                  "weaponAttack",
                  "dash",
                  "disengage",
                  "hide",
                  "useObject"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "attacks": {
              "const": 1
            }
          },
          "required": [
            "kinds",
            "attacks"
          ],
          "additionalProperties": false
        },
        "onEnd": {
          "const": "no-actions-until-next-turn-end"
        },
        "when": {
          "enum": [
            "always",
            "success",
            "failure"
          ]
        }
      },
      "required": [
        "id",
        "stack",
        "duration",
        "modifiers",
        "conditions",
        "concentration"
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "mode": {
          "enum": [
            "automatic",
            "manual",
            "referenced"
