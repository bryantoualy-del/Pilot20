{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pilot20.invalid/schemas/session-v1.schema.json",
  "title": "Pilot20 session v1",
  "description": "Structure only; model.js additionally checks dynamic bounds, references and uniqueness.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "ruleset": {
      "const": "dnd5e-2014"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "mode": {
      "enum": [
        "local",
        "free",
        "encounter"
      ]
    },
    "actors": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/actor"
      },
      "minProperties": 1,
      "maxProperties": 100
    },
    "activeActorId": {
      "$ref": "#/$defs/id"
    },
    "turnId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "receipts": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/receipt"
      }
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/history"
      }
    },
    "layout": {
      "type": "object"
    },
    "reactive": {
      "$ref": "#/$defs/reactiveRuntime"
    }
  },
  "required": [
    "schemaVersion",
    "ruleset",
    "revision",
    "mode",
    "actors",
    "activeActorId",
    "turnId",
    "receipts",
    "history",
    "layout"
  ],
  "additionalProperties": true,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$",
      "not": {
        "enum": [
          "constructor",
          "prototype",
          "__proto__"
        ]
      }
    },
    "resource": {
      "type": "object",
      "properties": {
        "max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "recovery": {
          "enum": [
            "short",
            "long",
            "none"
          ]
        },
        "slotLevel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "pool": {
          "enum": [
            "standard",
            "pact"
          ]
        }
      },
      "required": [
        "max",
        "recovery"
      ],
      "additionalProperties": true
    },
    "effect": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "damage",
            "heal",
            "tempHp"
          ]
        },
        "amount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "dice": {
          "type": "string",
          "pattern": "^\\d{1,2}d\\d{1,3}([+-]\\d{1,4})?$"
        },
        "damageType": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": true,
      "oneOf": [
        {
          "required": [
            "amount"
          ],
          "not": {
            "required": [
              "dice"
            ]
          }
        },
        {
          "required": [
            "dice"
          ],
          "not": {
            "required": [
              "amount"
            ]
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "damage"
              }
            }
          },
          "then": {
            "required": [
              "damageType"
            ]
          }
        }
      ]
    },
    "ability": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "cost": {
          "enum": [
            "action",
            "bonus",
            "reaction",
            "none"
          ]
        },
        "target": {
          "enum": [
            "self",
            "selected"
          ]
        },
        "maxTargets": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "attackAction": {
          "type": "boolean"
        },
        "attack": {
          "type": "object",
          "properties": {
            "bonus": {
              "type": "integer",
              "minimum": -20,
              "maximum": 100
            }
          },
          "required": [
            "bonus"
          ],
          "additionalProperties": true
        },
        "resource": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "amount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          },
          "required": [
            "id",
            "amount"
          ],
          "additionalProperties": true
        },
        "concentration": {
          "type": "object",
          "properties": {
            "effectId": {
              "$ref": "#/$defs/id"
            },
            "start": {
              "enum": [
                "activation",
                "hit"
              ]
            }
          },
          "required": [
            "effectId",
            "start"
          ],
          "additionalProperties": false
        },
        "combat": {
          "$ref": "https://pilot20.invalid/schemas/combat-rules-v1.schema.json#/$defs/compiledProfile"
        },
        "save": {
          "type": "object",
          "properties": {
            "ability": {
              "enum": [
                "str",
                "dex",
                "con",
                "int",
                "wis",
                "cha"
              ]
            },
            "dc": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "onSuccess": {
              "enum": [
                "full",
                "half",
                "none"
              ]
            }
          },
          "required": [
            "ability",
            "dc",
            "onSuccess"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "cost",
        "target",
        "maxTargets",
        "effects"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "required": [
              "concentration"
            ],
            "properties": {
              "concentration": {
                "properties": {
                  "start": {
                    "const": "hit"
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "attack"
            ]
          }
        }
      ]
    },
    "definition": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "maxHp": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "ac": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "attacksPerAction": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "saves": {
          "type": "object",
          "properties": {
            "con": {
              "type": "integer",
              "minimum": -20,
              "maximum": 100
            }
          },
          "required": [
            "con"
          ],
          "additionalProperties": true
        },
        "resources": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/resource"
          }
        },
        "abilities": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/ability"
          }
        },
        "resistances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "immunities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "vulnerabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "speed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "rules": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/reactiveRule"
          }
        },
        "castingModifiers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
              },
              "costs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "resourceId": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
                    },
                    "amount": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "resourceId",
                    "amount"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 100
              },
              "operation": {
                "enum": [
                  "castingTime",
                  "firstSaveDisadvantage"
                ]
              },
              "from": {
                "const": "action"
              },
              "to": {
                "const": "bonus"
              },
              "exclusiveGroup": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
              }
            },
            "required": [
              "id",
              "costs",
              "operation",
              "exclusiveGroup"
            ],
            "additionalProperties": false
          },
          "maxItems": 20
        }
      },
      "required": [
        "id",
        "name",
        "level",
        "maxHp",
        "ac",
        "attacksPerAction",
        "saves",
        "resources",
        "abilities",
        "resistances",
        "immunities",
        "vulnerabilities"
      ],
      "additionalProperties": true
    },
    "actor": {
      "type": "object",
      "properties": {
        "definition": {
          "$ref": "#/$defs/definition"
        },
        "hp": {
          "type": "object",
          "properties": {
            "current": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "max": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "temp": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            }
          },
          "required": [
            "current",
            "max",
            "temp"
          ],
          "additionalProperties": true
        },
        "resources": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          }
        },
        "economy": {
          "type": "object",
          "properties": {
            "action": {
              "type": "boolean"
            },
            "bonus": {
              "type": "boolean"
            },
            "reaction": {
              "type": "boolean"
            },
            "attacks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            }
          },
          "required": [
            "action",
            "bonus",
            "reaction",
            "attacks"
          ],
          "additionalProperties": true
        },
        "concentration": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "effectId": {
                  "$ref": "#/$defs/id"
                },
                "instanceId": {
                  "$ref": "#/$defs/id"
                }
              },
              "required": [
                "effectId",
                "instanceId"
              ],
              "additionalProperties": true
            }
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "instanceId": {
                "$ref": "#/$defs/id"
              },
              "dc": {
                "type": "integer",
                "minimum": 10,
                "maximum": 1000000
              }
            },
            "required": [
              "id",
              "instanceId",
              "dc"
            ],
            "additionalProperties": true
          }
        },
        "incapacitated": {
          "type": "boolean"
        },
        "advanced": {
          "$ref": "https://pilot20.invalid/schemas/combat-rules-v1.schema.json#/$defs/advancedRuntime"
        }
      },
      "required": [
        "definition",
        "hp",
        "resources",
        "economy",
        "concentration",
        "checks",
        "incapacitated"
      ],
      "additionalProperties": true
    },
    "game": {
      "type": "object",
      "properties": {
        "actors": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/actor"
          },
          "minProperties": 1,
          "maxProperties": 100
        },
        "activeActorId": {
          "$ref": "#/$defs/id"
        },
        "turnId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "reactive": {
          "$ref": "#/$defs/reactiveRuntime"
        }
      },
      "required": [
        "actors",
        "activeActorId",
        "turnId"
      ],
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "properties": {
        "fingerprint": {
          "type": "string"
        },
        "result": {
          "type": "object"
        }
      },
      "required": [
        "fingerprint",
        "result"
      ],
      "additionalProperties": true
    },
    "history": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "command": {
          "type": "object"
        },
        "result": {
          "type": "object"
        },
        "before": {
          "$ref": "#/$defs/game"
        }
      },
      "required": [
        "id",
        "before"
      ],
      "additionalProperties": true
    },
    "reactiveDecision": {
      "type": "object",
      "properties": {
        "version": {
          "const": 2
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
        },
        "eventId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
        },
        "actorId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "status": {
          "enum": [
            "pending",
            "resolved",
            "declined",
            "cancelled"
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
              },
              "label": {
                "type": "string"
              },
              "costs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "resourceId": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
                    },
                    "amount": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1000000
                    }
                  },
                  "required": [
                    "resourceId",
                    "amount"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 30
              }
            },
            "required": [
              "id",
              "label",
              "costs"
            ],
            "additionalProperties": false
          },
          "maxItems": 30
        },
        "continuation": {
          "type": "object",
          "properties": {
            "eventId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
            },
            "phase": {
              "enum": [
                "cast",
                "after-roll",
                "before-hit",
                "after-hit",
                "before-damage",
                "after-damage"
              ]
            }
          },
          "required": [
            "eventId",
            "phase"
          ],
          "additionalProperties": false
        },
        "policy": {
          "const": "block-dependent-resolution"
        },
        "ruleId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
        },
        "phase": {
          "enum": [
            "cast",
            "after-roll",
            "before-hit",
            "after-hit",
            "before-damage",
            "after-damage"
          ]
        },
        "validationRequired": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^external\\."
          }
        }
      },
      "required": [
        "version",
        "id",
        "eventId",
        "actorId",
        "revision",
        "status",
        "options",
        "continuation",
        "policy",
        "ruleId",
        "phase"
      ],
      "additionalProperties": false
    },
    "reactiveReactionwindow": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "eventId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
        },
        "phase": {
          "enum": [
            "cast",
            "after-roll",
            "before-hit",
            "after-hit",
            "before-damage",
            "after-damage"
          ]
        },
        "decisionId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
        },
        "status": {
          "const": "pending"
        }
      },
      "required": [
        "version",
        "eventId",
        "phase",
        "decisionId",
        "status"
      ],
      "additionalProperties": false
    },
    "reactiveContinuation": {
      "type": "object",
      "properties": {
        "command": {
          "type": "object",
          "required": [
            "id",
            "type",
            "actorId",
            "abilityId"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
            },
            "type": {
              "const": "useAbility"
            },
            "actorId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
            },
            "abilityId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
            }
          }
        },
        "ability": {
          "type": "object"
        },
        "targetIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
          },
          "maxItems": 20
        },
        "slotLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "natural": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 20
        },
        "total": {
          "type": [
            "integer",
            "null"
          ]
        },
        "critical": {
          "type": "boolean"
        },
        "hit": {
          "type": "boolean"
        },
        "saves": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
          },
          "additionalProperties": {
            "type": "integer"
          }
        }
      },
      "required": [
        "command",
        "ability",
        "targetIds",
        "slotLevel",
        "natural",
        "total",
        "critical",
        "hit",
        "saves"
      ],
      "additionalProperties": false
    },
    "reactiveEvent": {
      "type": "object",
      "properties": {
        "version": {
          "const": 2
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
        },
        "actorId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
        },
        "targetIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
          },
          "maxItems": 20
        },
        "phase": {
          "enum": [
            "cast",
            "after-roll",
            "before-hit",
            "after-hit",
            "before-damage",
            "after-damage"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "status": {
          "enum": [
            "pending",
            "completed",
            "cancelled"
          ]
        },
        "plan": {
          "$ref": "#/$defs/reactiveContinuation"
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reactiveDecision"
          },
          "maxItems": 200
        },
        "window": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/reactiveReactionwindow"
            }
          ]
        },
        "processed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 200
        },
        "modifiers": {
          "type": "object",
          "properties": {
            "attackTotal": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "damageDivisor": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1024
            },
            "cancelled": {
              "type": "boolean"
            },
            "damage": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "dice": {
                    "type": "string"
                  },
                  "damageType": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,119}$"
                  },
                  "rolls": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000
                    },
                    "maxItems": 100
                  }
                },
                "required": [
                  "dice",
                  "damageType",
