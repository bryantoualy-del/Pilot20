  {
    "id": "p20:effect:modifier",
    "version": "1.0.0",
    "name": {
      "fr": "Modifier numérique",
      "en": "modifier"
    },
    "classification": "calculable",
    "implementedInPilot20": false,
    "parameterSchema": {
      "type": "object",
      "properties": {
        "stat": {
          "enum": [
            "ac",
            "attack",
            "damage",
            "spell-attack",
            "spell-save-dc",
            "saving-throws",
            "initiative"
          ]
        },
        "value": {
          "type": "number"
        },
        "operation": {
          "enum": [
            "add",
            "set",
            "multiply"
          ]
        },
        "scope": {
          "type": "string"
        }
      },
      "required": [
        "stat",
        "value",
        "operation",
        "scope"
      ],
      "additionalProperties": false
    },
    "schemaDefinitions": "../schemas/magic-item.schema.json#/$defs",
    "stacking": "source-instance-and-effect-id; never stack an item with itself",
    "fallback": "manual",
    "notes": "Contract only. Unknown conditions or missing type/DC must prevent automatic resolution."
  },
  {
    "id": "p20:effect:damage",
    "version": "1.0.0",
    "name": {
      "fr": "Dégâts",
      "en": "damage"
    },
    "classification": "automatable-with-context",
    "implementedInPilot20": false,
    "parameterSchema": {
      "type": "object",
      "properties": {
        "dice": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]*d[1-9][0-9]*(?:[+-][0-9]+)?|[0-9]+)$"
        },
        "damageType": {
          "anyOf": [
            {
              "enum": [
                "acid",
                "bludgeoning",
                "cold",
                "fire",
                "force",
                "lightning",
                "necrotic",
                "piercing",
                "poison",
                "psychic",
                "radiant",
                "slashing",
                "thunder"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "enum": [
            "weapon-base",
            "additional",
            "standalone"
          ]
        }
      },
      "required": [
        "dice",
        "damageType",
        "role"
      ],
      "additionalProperties": false
    },
    "schemaDefinitions": "../schemas/magic-item.schema.json#/$defs",
    "stacking": "source-instance-and-effect-id; never stack an item with itself",
    "fallback": "manual",
    "notes": "Contract only. Unknown conditions or missing type/DC must prevent automatic resolution."
  },
